MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=prismwellness
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
SUPPORT_EMAIL=support@prisimwellness.com

# SMTP configuration for transactional email (contact confirmations, orders, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_FROM=Prisim Wellness <info@prisimwellness.com>
EMAIL_WORKER_ENABLED=true

# Optional absolute paths when Node is not on the backend process PATH:
# NODE_BINARY=/usr/bin/node
# EMAIL_RENDERER_PATH=/absolute/path/to/Frontend/dist-email/render.cjs
HOST=127.0.0.1
PORT=8000
