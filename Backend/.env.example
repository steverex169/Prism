MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=prismwellness
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# SMTP mailbox configuration
SUPPORT_EMAIL=info@prisimwellness.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=info@prisimwellness.com
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT=20
EMAIL_FROM=Prisim Wellness <info@prisimwellness.com>
EMAIL_WORKER_ENABLED=true

# Optional absolute paths when Node is not on the backend process PATH:
# NODE_BINARY=/usr/bin/node
# EMAIL_RENDERER_PATH=/absolute/path/to/Frontend/dist-email/render.cjs
HOST=127.0.0.1
PORT=8000
